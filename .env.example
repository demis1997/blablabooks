# Public site URL (local or production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (leave blank to run in demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Required for npm run seed / create-admin / Instagram token storage
SUPABASE_SERVICE_ROLE_KEY=

# Meta Instagram API with Instagram Login (Creator or Business). Never prefix these with NEXT_PUBLIC_.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Protects /api/cron/instagram (Vercel sends Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
