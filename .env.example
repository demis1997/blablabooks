# Public site URL (local or production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (leave blank to run in demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the browser. Required for npm run seed / create-admin
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Instagram Graph API (Business/Creator account) for the live gallery
# Do not scrape instagram.com. Create a Meta app, connect @bla.bla.books.cy, then set:
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
